// Plano de control de ORQUESTER: quien es quien, quien puede que, y que
// flujos existen. La EJECUCION no vive aca — el kanban de Hermes es SQLite y
// es suyo (ARQUITECTURA.md §13). Postgres guarda diseño y gobierno; el kanban
// guarda lo que esta corriendo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  // Hash Argon2id. La contraseña en claro no entra a este proceso mas que
  // el tiempo de verificarla.
  passwordHash String
  nombre       String?
  creadoEn     DateTime     @default(now())
  membresias   Membership[]
  sesiones     Session[]
  versiones    GraphVersion[]
  ejecuciones  Run[]
  auditoria    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  // Solo el hash del token: si se filtra la base, las sesiones no son usables.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  @@index([userId])
}

model Org {
  id          String       @id @default(cuid())
  nombre      String
  slug        String       @unique
  creadoEn    DateTime     @default(now())
  membresias  Membership[]
  grafos      Graph[]
  auditoria   AuditLog[]
}

enum Rol {
  OWNER    // manda: miembros, borrar la org
  EDITOR   // diseña y ejecuta
  VIEWER   // mira, no ejecuta
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  rol      Rol
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creadoEn DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Graph {
  id        String         @id @default(cuid())
  orgId     String
  org       Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nombre    String
  slug      String
  creadoEn  DateTime       @default(now())
  versiones GraphVersion[]
  runs      Run[]

  @@unique([orgId, slug])
}

// El pasado no se reescribe: una version es inmutable. Editar un flujo crea
// una version nueva; nunca se pisa la anterior, porque una corrida vieja tiene
// que poder explicarse con el grafo que de verdad se ejecuto.
model GraphVersion {
  id        String   @id @default(cuid())
  graphId   String
  graph     Graph    @relation(fields: [graphId], references: [id], onDelete: Cascade)
  numero    Int
  spec      Json     // el grafo tal cual lo compila el motor
  mensaje   String?
  autorId   String?
  autor     User?    @relation(fields: [autorId], references: [id], onDelete: SetNull)
  creadoEn  DateTime @default(now())
  runs      Run[]

  @@unique([graphId, numero])
}

// Una ejecucion. El estado vivo lo tiene el kanban; aca queda el puntero al
// board y quien la lanzo, que es lo que el kanban no sabe.
model Run {
  id         String    @id @default(cuid())
  graphId    String
  graph      Graph     @relation(fields: [graphId], references: [id], onDelete: Cascade)
  versionId  String
  version    GraphVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  board      String    // board del kanban de Hermes
  lanzadaPor String?
  usuario    User?     @relation(fields: [lanzadaPor], references: [id], onDelete: SetNull)
  parametros Json?
  estado     String    @default("corriendo")
  creadoEn   DateTime  @default(now())
  cerradaEn  DateTime?

  @@index([graphId])
}

// Quien hizo que. Append-only por diseño: sin update ni delete en el servicio.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  accion    String   // "graph.create", "run.start", "member.invite", ...
  recurso   String?
  detalle   Json?
  creadoEn  DateTime @default(now())

  @@index([orgId, creadoEn])
}
